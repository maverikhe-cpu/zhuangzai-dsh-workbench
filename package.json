{
  "name": "@yiqizhuang/zhuangzai-dsh-workbench",
  "version": "0.4.3",
  "private": false,
  "description": "装仔交付管理工作台：角色、场景技能和一起装 MCP",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "presets",
    "connector",
    "README.md",
    "lib",
    "LICENSE",
    "CHANGELOG.md",
    "assets"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "license": "MIT",
  "author": "一起装 · 丁满信息科技（上海）有限公司",
  "homepage": "https://github.com/maverikhe-cpu/zhuangzai-dsh-workbench",
  "repository": {
    "type": "git",
    "url": "https://github.com/maverikhe-cpu/zhuangzai-dsh-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/maverikhe-cpu/zhuangzai-dsh-workbench/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "yiqizhuang",
    "zhuangzai",
    "construction",
    "delivery-management",
    "mcp",
    "装仔",
    "一起装",
    "交付管理",
    "家装",
    "派工",
    "验收"
  ],
  "scripts": {
    "test": "node --test tests/test-auth.mjs && node tests/test-ui.mjs"
  }
}
