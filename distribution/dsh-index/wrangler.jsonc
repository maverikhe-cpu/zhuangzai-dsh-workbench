{
  "name": "yiqizhuang-dsh-plugins",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "plugins.1qizhuang.win",
      "custom_domain": true
    }
  ]
}
